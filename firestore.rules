rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The only account allowed to edit content / read messages (email + password sign-in).
    // Keep in sync with NEXT_PUBLIC_ADMIN_EMAIL. Public sign-up must be disabled in Firebase Auth
    // (Authentication → Settings → User actions → uncheck "Enable create (sign-up)").
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "nisheshsingla@gmail.com";
    }

    // Site content (one JSON document). Public read so the site can render it; only the admin writes.
    match /site/content {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['data', 'updatedAt', 'updatedBy'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
    }

    // Backups written on every save. Admin only.
    match /site_history/{id} {
      allow read, create, delete: if isAdmin();
      allow update: if false;
    }

    // Contact form: anyone may create a well-formed message; only the admin can read / delete.
    match /messages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'message', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') && request.resource.data.email.size() <= 200
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 5000
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
